rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // First security phase: only the verified owner account may access Firestore.
    // Employee roles and public-store access will be introduced later through
    // server-verified authorization, not client-controlled fields.
    function isAuthorizedAdministrator() {
      return request.auth != null
        && request.auth.token.email == 'diomrondon@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Deny all unauthenticated users and all accounts other than the owner.
    // This recursive rule also covers future collections and subcollections.
    match /{document=**} {
      allow read, write: if isAuthorizedAdministrator();
    }
  }
}
